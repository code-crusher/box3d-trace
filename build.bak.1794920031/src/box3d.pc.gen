prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: box3d
Description: A 3D physics engine for games
Version: 0.1.0
Libs: -L${libdir} -lbox3d$<$<CONFIG:Debug>:d> -lm
Libs.private: 
Cflags: -I${includedir}$<$<CONFIG:RELWITHDEBINFO>: -DB3_ENABLE_ASSERT>
